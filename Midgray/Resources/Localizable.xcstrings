    "EV measures how much light there is in the scene. Higher numbers mean brighter light: around 15 on a sunny day, around 5 in a dim room." : {
      "comment" : "Help topic about EV",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EV measures how much light there is in the scene. Higher numbers mean brighter light: around 15 on a sunny day, around 5 in a dim room."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El EV mide cuánta luz hay en la escena. Los números más altos indican más luz: alrededor de 15 en un día soleado y de 5 en una habitación con poca luz."
          }
        }
      }
    },
